# URL của Spring Boot API
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Chế độ độc lập (tạm thời): true = không cần backend/PostgreSQL. Mọi chức năng vẫn chạy, nhưng dữ liệu nội dung
# lấy từ file đóng gói sẵn và tiến độ/tài khoản lưu ở localStorage của trình duyệt (không đồng bộ giữa các máy).
# Đổi giá trị phải khởi động lại `next dev`; với Docker thì cần truyền lúc build.
NEXT_PUBLIC_STANDALONE=false
