# Cấu hình cho docker compose. Sao chép thành .env (đã có trong .gitignore) rồi điền giá trị.

# URL công khai người dùng mở trong trình duyệt — không có dấu / ở cuối.
# Được nhúng vào trang lúc build (canonical, sitemap, Open Graph): đổi giá trị này phải build lại.
SITE_URL=http://localhost:3000

# Cổng web mở ra máy chủ (Nginx/CDN phía trước proxy vào đây).
WEB_PORT=3000
