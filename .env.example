# Cấu hình cho docker compose. Sao chép thành .env (đã có trong .gitignore) rồi điền giá trị.

# URL công khai người dùng mở trong trình duyệt — không có dấu / ở cuối.
# Dùng làm CORS_ORIGINS của backend và được nhúng vào bundle web lúc build (đổi phải build lại).
SITE_URL=http://localhost:3000

# Cổng web mở ra máy chủ (Nginx proxy vào đây).
WEB_PORT=3000

# CSDL — mật khẩu mạnh, không dùng lại giá trị mẫu.
DB_USER=kanadojo
DB_PASSWORD=

# Khoá ký JWT, base64 ≥ 256 bit:  openssl rand -base64 48
JWT_SECRET=

# Google OAuth client ID. Profile prod của backend bắt buộc có giá trị; nếu chưa dùng đăng nhập Google,
# đặt tạm một chuỗi bất kỳ (nút Google sẽ không hoạt động).
GOOGLE_CLIENT_ID=

# Tuỳ chọn
# SRS_NEW_CARDS_PER_DAY=10
