# Cấu hình cho docker compose. Sao chép thành .env (đã có trong .gitignore) rồi điền giá trị.
# Web ở chế độ cá nhân (docs/LOCAL_MODE.md): không có backend/CSDL nên chỉ còn hai biến dưới đây.
# Các biến của server được giữ nguyên dưới dạng comment (đánh dấu `[máy chủ — đang tắt]`).

# URL công khai người dùng mở trong trình duyệt — không có dấu / ở cuối.
# Được nhúng vào bundle web lúc build (đổi phải build lại).
SITE_URL=http://localhost:3000

# Cổng web mở ra máy chủ (Nginx proxy vào đây).
WEB_PORT=3000

# [máy chủ — đang tắt] CSDL — mật khẩu mạnh, không dùng lại giá trị mẫu.
# [máy chủ — đang tắt] DB_USER=kanadojo
# [máy chủ — đang tắt] DB_PASSWORD=

# [máy chủ — đang tắt] Khoá ký JWT, base64 ≥ 256 bit:  openssl rand -base64 48
# [máy chủ — đang tắt] JWT_SECRET=

# [máy chủ — đang tắt] Google OAuth client ID. Profile prod của backend bắt buộc có giá trị; nếu chưa dùng đăng nhập Google,
# [máy chủ — đang tắt] đặt tạm một chuỗi bất kỳ (nút Google sẽ không hoạt động).
# [máy chủ — đang tắt] GOOGLE_CLIENT_ID=

# [máy chủ — đang tắt] Tuỳ chọn
# [máy chủ — đang tắt] SRS_NEW_CARDS_PER_DAY=10
